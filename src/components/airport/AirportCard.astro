---
import type { Airport } from '../../types/airport';

export interface Props {
  airport: Airport;
  featured?: boolean;
}

const { airport, featured = false } = Astro.props;

// Badge colors
const badgeColors: Record<string, string> = {
  '编辑推荐': 'bg-emerald-500/10 text-emerald-400 border-emerald-500/30',
  '高性价比': 'bg-blue-500/10 text-blue-400 border-blue-500/30',
  '稳定可靠': 'bg-amber-500/10 text-amber-400 border-amber-500/30',
  '解锁增强': 'bg-purple-500/10 text-purple-400 border-purple-500/30',
  '入门优选': 'bg-emerald-500/10 text-emerald-400 border-emerald-500/30',
  '跨境办公': 'bg-cyan-500/10 text-cyan-400 border-cyan-500/30',
};

const badgeClass = airport.badge && badgeColors[airport.badge] 
  ? badgeColors[airport.badge] 
  : 'bg-emerald-500/10 text-emerald-400 border-emerald-500/30';
---

<div class="group relative flex flex-col justify-between rounded-2xl bg-[var(--bg-surface)] border border-[var(--border-subtle)] hover:border-emerald-500/50 p-5 transition-all duration-300 hover:shadow-xl hover:shadow-emerald-950/20 hover:-translate-y-1">
  <div>
    <!-- Card Header: Badge & Status -->
    <div class="flex items-center justify-between gap-2 mb-3.5">
      {airport.badge ? (
        <span class={`text-[11px] font-semibold px-2.5 py-0.5 rounded-full border ${badgeClass}`}>
          {airport.badge}
        </span>
      ) : (
        <span class="text-[11px] font-semibold px-2.5 py-0.5 rounded-full border bg-[var(--bg-card)] text-[var(--text-dim)] border-[var(--border-subtle)]">
          已核验收录
        </span>
      )}

      {airport.rating && (
        <div class="flex items-center gap-1 text-xs font-bold text-amber-400">
          <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24">
            <path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/>
          </svg>
          <span>{airport.rating.toFixed(1)}</span>
        </div>
      )}
    </div>

    <!-- Airport Identity -->
    <div class="flex items-start gap-3.5 mb-3">
      <div class="w-12 h-12 rounded-xl bg-[var(--bg-card)] border border-[var(--border-subtle)] flex items-center justify-center shrink-0 p-2.5 group-hover:border-emerald-500/40 transition-colors">
        <img src={airport.logo} alt={airport.name} class="w-full h-full object-contain" loading="lazy" />
      </div>
      <div>
        <h3 class="text-base sm:text-lg font-bold text-[var(--text-main)] group-hover:text-emerald-400 transition-colors flex items-center gap-1.5">
          <a href={`/airport/${airport.slug}/`}>
            {airport.name}
          </a>
        </h3>
        <p class="text-xs text-[var(--text-dim)] line-clamp-1 mt-0.5">{airport.tagline}</p>
      </div>
    </div>

    <!-- Feature Tags Row -->
    <div class="flex flex-wrap gap-1.5 mb-4">
      {airport.routes.slice(0, 2).map((route) => (
        <span class="text-[11px] px-2 py-0.5 rounded bg-[var(--bg-card)] text-[var(--text-muted)] border border-[var(--border-subtle)]">
          {route}
        </span>
      ))}
      {airport.ai.chatgpt && (
        <span class="text-[11px] px-2 py-0.5 rounded bg-emerald-500/10 text-emerald-400 border border-emerald-500/20">
          ChatGPT
        </span>
      )}
      {airport.streaming.netflix && (
        <span class="text-[11px] px-2 py-0.5 rounded bg-red-500/10 text-red-400 border border-red-500/20">
          Netflix
        </span>
      )}
      {airport.trial.supported && (
        <span class="text-[11px] px-2 py-0.5 rounded bg-amber-500/10 text-amber-400 border border-amber-500/20">
          体验包
        </span>
      )}
    </div>

    <!-- Price Section -->
    <div class="pt-3 border-t border-[var(--border-subtle)] flex items-baseline justify-between mb-4">
      <div>
        <span class="text-xs text-[var(--text-dim)]">起步价格</span>
        <div class="text-lg sm:text-xl font-extrabold text-[var(--text-main)] font-mono">
          ¥{airport.price.startingMonthly}
          <span class="text-xs font-normal text-[var(--text-dim)]">/月起</span>
        </div>
      </div>
      <div class="text-right">
        <span class="text-[10px] text-[var(--text-dim)] block">核验周期</span>
        <span class="text-xs text-[var(--text-muted)] font-mono">{airport.lastVerified}</span>
      </div>
    </div>
  </div>

  <!-- Actions Row -->
  <div class="grid grid-cols-3 gap-1.5 pt-2">
    <!-- View Details -->
    <a
      href={`/airport/${airport.slug}/`}
      class="px-2.5 py-2 rounded-xl bg-[var(--bg-card)] hover:bg-[var(--bg-card-hover)] border border-[var(--border-subtle)] text-xs text-[var(--text-muted)] hover:text-[var(--text-main)] text-center font-medium transition-colors flex items-center justify-center"
    >
      详情
    </a>

    <!-- Add to Compare -->
    <button
      type="button"
      data-airport={JSON.stringify(airport)}
      class="btn-add-compare px-2 py-2 rounded-xl bg-[var(--bg-card)] hover:bg-emerald-500/15 hover:text-emerald-400 border border-[var(--border-subtle)] text-xs text-[var(--text-muted)] text-center font-medium transition-colors flex items-center justify-center gap-1 cursor-pointer"
      title="加入对比盘"
    >
      <span>+ 对比</span>
    </button>

    <!-- Visit Official -->
    <a
      href={airport.affiliateUrl}
      target="_blank"
      rel="nofollow noopener noreferrer"
      class="px-2.5 py-2 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white text-xs font-semibold text-center transition-all flex items-center justify-center gap-1 shadow-sm active:scale-95"
    >
      <span>官网</span>
      <svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
        <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
        <polyline points="15 3 21 3 21 9"></polyline>
        <line x1="10" y1="14" x2="21" y2="3"></line>
      </svg>
    </a>
  </div>
</div>

<script>
  // Add to compare event dispatcher
  document.querySelectorAll('.btn-add-compare').forEach((btn) => {
    btn.addEventListener('click', (e) => {
      e.preventDefault();
      const raw = (btn as HTMLElement).getAttribute('data-airport');
      if (raw) {
        try {
          const airport = JSON.parse(raw);
          const event = new CustomEvent('jcs:compare:toggle', { detail: airport });
          window.dispatchEvent(event);
        } catch (err) {
          console.error(err);
        }
      }
    });
  });
</script>

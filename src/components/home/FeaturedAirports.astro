---
import AirportCard from '../airport/AirportCard.astro';
import { getFeaturedAirports } from '../../utils/airports';

const featuredList = getFeaturedAirports();
---

<section class="py-12 md:py-16 border-b border-[var(--border-subtle)]">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Section Header -->
    <div class="flex items-end justify-between mb-8">
      <div>
        <div class="flex items-center gap-2 text-xs font-semibold text-emerald-400 mb-1 tracking-wider uppercase">
          <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
          VERIFIED SELECTION
        </div>
        <h2 class="text-xl sm:text-2xl md:text-3xl font-extrabold text-[var(--text-main)] tracking-tight">
          精选机场推荐
        </h2>
        <p class="text-xs sm:text-sm text-[var(--text-dim)] mt-1">
          多维实测核验 · 拒绝虚构在线率与假节点 · 真实场景定位清晰
        </p>
      </div>

      <a
        href="/airports/"
        class="text-xs sm:text-sm font-medium text-[var(--text-muted)] hover:text-emerald-400 flex items-center gap-1 transition-colors"
      >
        <span>查看完整机场库</span>
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="m9 18 6-6-6-6"/>
        </svg>
      </a>
    </div>

    <!-- 4 Cards Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-5">
      {featuredList.map((airport) => (
        <AirportCard airport={airport} featured={true} />
      ))}
    </div>
  </div>
</section>

---
const hotQuestions = [
  {
    id: 'vpn-vs-airport',
    question: '机场和传统 VPN 有什么本质区别？',
    tag: '入门科普',
    views: '2.8k 查阅',
    href: '/answers/vpn-vs-airport/',
    summary: '传统 VPN 采用全局单节点封装加密，易受干扰；机场基于多协议分流代理（Shadowsocks/VLESS/Trojan），可智能区分境内外流量。',
  },
  {
    id: 'subscription-failed',
    question: '订阅链接导入后无法使用/节点全红怎么办？',
    tag: '使用问题',
    views: '3.5k 查阅',
    href: '/answers/subscription-failed/',
    summary: '90% 由系统时间不同步、订阅转换失效或代理端口冲突导致。首要检查设备系统时间是否精确到秒。',
  },
  {
    id: 'clash-no-internet',
    question: 'Clash 有节点和延迟，但浏览器无法上网？',
    tag: '故障排查',
    views: '4.2k 查阅',
    href: '/answers/clash-no-internet/',
    summary: '检查系统代理开关是否被其他安全软件拦截，或在设置中切换为 TUN 虚拟网卡模式彻底接管流量。',
  },
  {
    id: 'how-to-judge',
    question: '如何客观判断一个机场是否可靠稳定？',
    tag: '选购指南',
    views: '1.9k 查阅',
    href: '/answers/how-to-judge/',
    summary: '观察其是否提供月付、入口是否有灾备冗余、是否承诺 SLA 以及客服工单响应速度，切勿盲信年付超低价。',
  },
  {
    id: 'clash-vs-shadowrocket',
    question: 'Clash 与 Shadowrocket (小火箭) 怎么选？',
    tag: '客户端对比',
    views: '2.1k 查阅',
    href: '/answers/clash-vs-shadowrocket/',
    summary: 'iOS 端首选 Shadowrocket，简单直接；PC / Mac 端推荐 Clash Verge 或 sing-box，规则分流功能更丰富。',
  },
  {
    id: 'speed-test-method',
    question: '如何正确测试节点真实速度与稳定性？',
    tag: '速度测试',
    views: '1.6k 查阅',
    href: '/answers/speed-test-method/',
    summary: '单次测速图仅代表瞬时带宽，应以晚高峰（20:00-23:00）4K 视频连续播放流畅度与丢包抖动为准。',
  },
];

const hotNews = [
  { title: 'ChatGPT / Claude 提示 Access Denied 解决方案', date: '08-16', href: '/scenarios/chatgpt/' },
  { title: '机场订阅周期选购指南：月付与年付深度权衡', date: '08-15', href: '/answers/how-to-judge/' },
  { title: 'IEPL 内网专线到底有什么优势？与普通中转解析', date: '08-14', href: '/answers/iplc-vs-relay/' },
  { title: '最新 sing-box 通用内核规则订阅转换指南', date: '08-12', href: '/clients/sing-box/' },
];
---

<section class="py-12 md:py-16 border-b border-[var(--border-subtle)]">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
      <!-- Left 2 Cols: 问题库 · 大家都在问 -->
      <div class="lg:col-span-2 space-y-6">
        <div class="flex items-center justify-between">
          <div>
            <div class="flex items-center gap-2 text-xs font-semibold text-emerald-400 mb-1 tracking-wider uppercase">
              <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
              DECISION FAQ & ANSWERS
            </div>
            <h2 class="text-xl sm:text-2xl font-extrabold text-[var(--text-main)] tracking-tight">
              问题库 · 大家都在问
            </h2>
            <p class="text-xs text-[var(--text-dim)] mt-0.5">30 秒直击痛点，拒绝废话与模糊表述</p>
          </div>

          <a
            href="/answers/"
            class="text-xs font-medium text-[var(--text-muted)] hover:text-emerald-400 transition-colors flex items-center gap-1"
          >
            <span>更多问题 (FAQ)</span>
            <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="m9 18 6-6-6-6"/>
            </svg>
          </a>
        </div>

        <!-- Question Cards Grid -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5">
          {hotQuestions.map((q) => (
            <a
              href={q.href}
              class="p-4 rounded-xl bg-[var(--bg-surface)] border border-[var(--border-subtle)] hover:border-emerald-500/40 hover:bg-[var(--bg-surface-elevated)] transition-all group flex flex-col justify-between"
            >
              <div>
                <div class="flex items-center justify-between gap-2 mb-2">
                  <span class="text-[10px] px-2 py-0.5 rounded bg-[var(--bg-card)] text-emerald-400 border border-[var(--border-subtle)] font-medium">
                    {q.tag}
                  </span>
                  <span class="text-[10px] text-[var(--text-dim)] font-mono">{q.views}</span>
                </div>
                <h3 class="text-sm font-bold text-[var(--text-main)] group-hover:text-emerald-400 transition-colors leading-snug mb-1.5">
                  {q.question}
                </h3>
                <p class="text-xs text-[var(--text-dim)] line-clamp-2 leading-relaxed">
                  {q.summary}
                </p>
              </div>

              <div class="mt-3 pt-2.5 border-t border-[var(--border-subtle)]/60 flex items-center justify-between text-[11px] text-emerald-400/80 group-hover:text-emerald-400">
                <span>查看 30 秒解决方案</span>
                <span>→</span>
              </div>
            </a>
          ))}
        </div>
      </div>

      <!-- Right 1 Col: 今日热点 & 行业观察 -->
      <div class="space-y-6">
        <div>
          <div class="flex items-center gap-2 text-xs font-semibold text-amber-400 mb-1 tracking-wider uppercase">
            <span class="w-2 h-2 rounded-full bg-amber-400"></span>
            TRENDS & INSIGHTS
          </div>
          <h2 class="text-xl sm:text-2xl font-extrabold text-[var(--text-main)] tracking-tight flex items-center gap-2">
            今日热点
            <span class="text-xs font-normal text-amber-400">🔥</span>
          </h2>
          <p class="text-xs text-[var(--text-dim)] mt-0.5">网络环境与技术最新动态</p>
        </div>

        <div class="rounded-2xl bg-[var(--bg-surface)] border border-[var(--border-subtle)] p-5 shadow-lg space-y-4">
          <div class="divide-y divide-[var(--border-subtle)]">
            {hotNews.map((news, idx) => (
              <a
                href={news.href}
                class="py-3.5 first:pt-0 last:pb-0 block group hover:translate-x-1 transition-transform"
              >
                <div class="flex items-start gap-3">
                  <span class={`w-5 h-5 rounded flex items-center justify-center font-bold text-xs shrink-0 ${
                    idx === 0
                      ? 'bg-amber-500/20 text-amber-400 font-mono'
                      : idx === 1
                      ? 'bg-emerald-500/20 text-emerald-400 font-mono'
                      : 'bg-[var(--bg-card)] text-[var(--text-dim)] font-mono'
                  }`}>
                    {idx + 1}
                  </span>
                  <div class="flex-1">
                    <h4 class="text-xs sm:text-sm font-semibold text-[var(--text-main)] group-hover:text-emerald-400 transition-colors leading-snug">
                      {news.title}
                    </h4>
                    <span class="text-[10px] text-[var(--text-dim)] font-mono mt-1 block">
                      更新于 2026-{news.date}
                    </span>
                  </div>
                </div>
              </a>
            ))}
          </div>

          <!-- Mini Callout -->
          <div class="p-3.5 rounded-xl bg-emerald-500/10 border border-emerald-500/20 text-xs">
            <div class="font-bold text-emerald-400 mb-1 flex items-center gap-1.5">
              <span>📡</span>
              机场雷达状态
            </div>
            <p class="text-[11px] text-[var(--text-muted)] leading-relaxed">
              全站监控的 6 家服务商官网域名与 HTTPS 证书均正常可用。
            </p>
            <a href="/radar/" class="inline-block mt-2 text-[11px] font-semibold text-emerald-400 hover:underline">
              进入实时雷达监控面板 →
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

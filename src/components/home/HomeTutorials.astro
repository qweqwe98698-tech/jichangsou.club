---
const tutorials = [
  {
    id: 'clash',
    title: 'Clash 使用教程',
    subtitle: '从下载到订阅导入图解',
    level: '新手入门',
    readTime: '12 分钟',
    href: '/clients/clash/',
    icon: '🐱',
    color: 'emerald',
  },
  {
    id: 'shadowrocket',
    title: 'Shadowrocket 教程',
    subtitle: 'iOS 小火箭配置指南',
    level: '进阶教程',
    readTime: '8 分钟',
    href: '/clients/shadowrocket/',
    icon: '🚀',
    color: 'blue',
  },
  {
    id: 'v2rayn',
    title: 'v2rayN 教程',
    subtitle: 'Windows 客户端详细配置',
    level: '新手入门',
    readTime: '10 分钟',
    href: '/clients/v2rayn/',
    icon: '⚡',
    color: 'purple',
  },
];
---

<div class="rounded-2xl bg-[var(--bg-surface)] border border-[var(--border-subtle)] p-5 sm:p-6 shadow-xl flex flex-col justify-between">
  <div>
    <!-- Header -->
    <div class="flex items-center justify-between pb-3.5 mb-4 border-b border-[var(--border-subtle)]">
      <div>
        <h3 class="text-base sm:text-lg font-bold text-[var(--text-main)] flex items-center gap-2">
          <span>📖</span>
          客户端新手教程
          <span class="text-[10px] px-2 py-0.5 rounded-full bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 font-medium">
            全图解
          </span>
        </h3>
        <p class="text-xs text-[var(--text-dim)]">从客户端下载、配置到订阅导入一步到位</p>
      </div>

      <a
        href="/clients/"
        class="text-xs text-[var(--text-muted)] hover:text-emerald-400 font-medium transition-colors flex items-center gap-0.5"
      >
        <span>全部教程</span>
        <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="m9 18 6-6-6-6"/>
        </svg>
      </a>
    </div>

    <!-- 3 Tutorial Cards Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
      {tutorials.map((item) => (
        <a
          href={item.href}
          class="flex flex-col items-center text-center p-4 rounded-xl bg-[var(--bg-card)] border border-[var(--border-subtle)] hover:border-emerald-500/40 hover:bg-[var(--bg-card-hover)] transition-all group hover:-translate-y-0.5"
        >
          <div class="w-12 h-12 rounded-2xl bg-[var(--bg-surface)] border border-[var(--border-subtle)] flex items-center justify-center text-2xl mb-3 shadow-inner group-hover:scale-110 transition-transform">
            {item.icon}
          </div>
          <h4 class="text-sm font-bold text-[var(--text-main)] group-hover:text-emerald-400 transition-colors mb-1">
            {item.title}
          </h4>
          <p class="text-[11px] text-[var(--text-dim)] mb-3 line-clamp-1">{item.subtitle}</p>
          <div class="mt-auto flex items-center gap-1.5 text-[10px]">
            <span class="px-1.5 py-0.5 rounded bg-[var(--bg-surface)] text-emerald-400 border border-[var(--border-subtle)]">
              {item.level}
            </span>
            <span class="text-[var(--text-dim)] font-mono">{item.readTime}</span>
          </div>
        </a>
      ))}
    </div>
  </div>

  <!-- Bottom CTA -->
  <div class="pt-4 mt-4 border-t border-[var(--border-subtle)] flex items-center justify-between text-xs text-[var(--text-dim)]">
    <span>💡 遇到订阅导入失败或有节点无网？</span>
    <a href="/answers/clash-no-internet/" class="text-emerald-400 hover:underline font-medium">
      查看故障排查指南 →
    </a>
  </div>
</div>

---
const currentYear = 2026;
---

<footer class="w-full border-t border-[var(--border-subtle)] bg-[var(--bg-surface)] text-[var(--text-muted)] transition-colors duration-200">
  <!-- Slogan & Trust Row -->
  <div class="border-b border-[var(--border-subtle)] bg-[var(--bg-main)]/60 py-6">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col md:flex-row items-center justify-between gap-4 text-xs">
      <div class="flex items-center gap-3">
        <div class="w-2.5 h-2.5 rounded-full bg-emerald-500 beacon-pulse"></div>
        <span class="font-medium text-[var(--text-main)]">数据状态：持续实时监测与人工核验已同步</span>
      </div>
      <div class="flex flex-wrap items-center gap-6 text-[var(--text-dim)]">
        <span>🛡️ 拒绝虚构在线率</span>
        <span>⚖️ 拒绝虚假节点数</span>
        <span>🔍 真实测试可溯源</span>
        <span>⚡ 静态高可用部署</span>
      </div>
    </div>
  </div>

  <!-- Main 4-Column Links -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-8 lg:gap-12">
      <!-- Col 1: 找机场 -->
      <div class="space-y-3">
        <h3 class="text-sm font-semibold text-[var(--text-main)] tracking-wider flex items-center gap-2">
          <span class="w-1.5 h-3.5 bg-emerald-500 rounded-sm"></span>
          找机场
        </h3>
        <ul class="space-y-2 text-xs">
          <li><a href="/deals/" class="text-emerald-600 dark:text-emerald-400 font-bold hover:underline">🎁 优惠情报与折扣码</a></li>
          <li><a href="/recommend/" class="hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors">精选机场推荐</a></li>
          <li><a href="/airports/" class="hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors">全部机场数据库</a></li>
          <li><a href="/compare/" class="hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors">多维参数对比</a></li>
          <li><a href="/airports/hongkong/" class="hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors">香港 IEPL 专线精选</a></li>
          <li><a href="/airports/japan/" class="hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors">日本低延迟专线</a></li>
          <li><a href="/airports/usa/" class="hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors">美国原生住宅专线</a></li>
          <li><a href="/airports/shadowrocket/" class="hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors">Shadowrocket (小火箭) 机场</a></li>
        </ul>
      </div>

      <!-- Col 2: 学使用 & 场景 -->
      <div class="space-y-3">
        <h3 class="text-sm font-semibold text-[var(--text-main)] tracking-wider flex items-center gap-2">
          <span class="w-1.5 h-3.5 bg-emerald-500 rounded-sm"></span>
          学使用 & 场景
        </h3>
        <ul class="space-y-2 text-xs">
          <li><a href="/clients/clash/" class="hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors">Clash 完整入门与配置</a></li>
          <li><a href="/clients/shadowrocket/" class="hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors">Shadowrocket (小火箭) 教程</a></li>
          <li><a href="/scenarios/tiktok/" class="hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors">TikTok 跨境电商专线</a></li>
          <li><a href="/scenarios/gaming/" class="hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors">外服游戏电竞低延迟</a></li>
          <li><a href="/scenarios/chatgpt/" class="hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors">ChatGPT / Claude 访问避坑</a></li>
          <li><a href="/scenarios/netflix/" class="hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors">Netflix / Disney+ 流媒体解锁</a></li>
        </ul>
      </div>

      <!-- Col 3: 解决问题 -->
      <div class="space-y-3">
        <h3 class="text-sm font-semibold text-[var(--text-main)] tracking-wider flex items-center gap-2">
          <span class="w-1.5 h-3.5 bg-emerald-500 rounded-sm"></span>
          解决问题
        </h3>
        <ul class="space-y-2 text-xs">
          <li><a href="/answers/" class="hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors">问题答案中心 (FAQ)</a></li>
          <li><a href="/radar/" class="hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors">机场雷达实时状态</a></li>
          <li><a href="/answers/clash-no-internet/" class="hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors">有节点但无法上网排查</a></li>
          <li><a href="/answers/subscription-failed/" class="hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors">机场订阅导入失败怎么办</a></li>
          <li><a href="/answers/iplc-vs-relay/" class="hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors">IPLC 专线与中转区别解析</a></li>
          <li><a href="/answers/how-to-judge/" class="hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors">如何判断机场是否可靠</a></li>
        </ul>
      </div>

      <!-- Col 4: 关于机场搜 -->
      <div class="space-y-3">
        <h3 class="text-sm font-semibold text-[var(--text-main)] tracking-wider flex items-center gap-2">
          <span class="w-1.5 h-3.5 bg-emerald-500 rounded-sm"></span>
          关于机场搜
        </h3>
        <ul class="space-y-2 text-xs">
          <li><a href="/about/" class="hover:text-emerald-400 transition-colors">关于本站 (Decision Hub)</a></li>
          <li><a href="/editorial-policy/" class="hover:text-emerald-400 transition-colors">内容编辑与评测规范</a></li>
          <li><a href="/data-methodology/" class="hover:text-emerald-400 transition-colors">数据采集与真实性方法论</a></li>
          <li><a href="/disclaimer/" class="hover:text-emerald-400 transition-colors">免责声明与合规说明</a></li>
          <li><a href="/sitemap-index.xml" class="hover:text-emerald-400 transition-colors">网站地图 (XML)</a></li>
          <li><a href="/rss.xml" class="hover:text-emerald-400 transition-colors">RSS 订阅源</a></li>
        </ul>
      </div>
    </div>

    <!-- Bottom Copyright & Brand Signature -->
    <div class="mt-12 pt-8 border-t border-[var(--border-subtle)] flex flex-col md:flex-row items-center justify-between gap-4 text-xs">
      <div class="flex items-center gap-3">
        <div class="w-6 h-6 rounded-lg bg-emerald-500/20 text-emerald-400 flex items-center justify-center font-bold text-xs">
          搜
        </div>
        <div class="text-[var(--text-dim)]">
          © {currentYear} <strong class="text-[var(--text-main)] font-medium">机场搜 jichangsou.club</strong>. 决策枢纽 · 搜得准 · 比得清 · 选得好.
        </div>
      </div>
      <div class="text-[var(--text-dim)] text-center md:text-right">
        非商业评测机构 · 所有测试均标注核验周期 · 建议以服务商官网实时信息为准
      </div>
    </div>
  </div>
</footer>

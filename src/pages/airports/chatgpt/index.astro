---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import AirportCard from '../../../components/airport/AirportCard.astro';
import { getAllAirports } from '../../../utils/airports';

const aiAirports = getAllAirports().filter((a) => a.ai.chatgpt);
---

<BaseLayout
  title="ChatGPT / Claude 专用机场推荐 | 原生独立 IP 不封号 - 机场搜"
  description="精选支持 OpenAI ChatGPT、Claude 3.5 Sonnet 与 Gemini 的专用机场。原生纯净住宅/商宽 IP，告别 Access Denied 报错。"
>
  <div class="py-12 md:py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <nav class="flex items-center gap-2 text-xs text-[var(--text-dim)] mb-6">
        <a href="/" class="hover:text-emerald-400">首页</a>
        <span>/</span>
        <a href="/airports/" class="hover:text-emerald-400">机场库</a>
        <span>/</span>
        <span class="text-[var(--text-main)]">AI 专用</span>
      </nav>

      <div class="max-w-3xl mb-8">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-500/10 text-emerald-400 text-xs font-semibold border border-emerald-500/20 mb-3">
          <span>🤖</span>
          <span>AI ACCELERATION & CLEAN IP</span>
        </div>
        <h1 class="text-2xl sm:text-3xl md:text-4xl font-extrabold text-[var(--text-main)] tracking-tight mb-3">
          ChatGPT / Claude 专用机场精选
        </h1>
        <p class="text-sm text-[var(--text-muted)] leading-relaxed">
          OpenAI 与 Anthropic 对机房数据中心 IP 审查极严。本合集收录具备原生住宅/纯净商业 IP 分流规则的机场，确保网页端与 API 调用顺畅无阻。
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {aiAirports.map((airport) => (
          <AirportCard airport={airport} />
        ))}
      </div>
    </div>
  </div>
</BaseLayout>

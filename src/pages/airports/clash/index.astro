---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import AirportCard from '../../../components/airport/AirportCard.astro';
import { getAllAirports } from '../../../utils/airports';

const clashAirports = getAllAirports().filter((a) => a.clients.some((c) => c.includes('Clash')));
---

<BaseLayout
  title="Clash 机场推荐 | 支持一键导入与规则分流 - 机场搜"
  description="精选完美适配 Clash Verge Rev、Clash Meta 与 Clash for Windows 的机场服务商。支持一键订阅导入、自动测速分组与智能分流。"
>
  <div class="py-12 md:py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <nav class="flex items-center gap-2 text-xs text-[var(--text-dim)] mb-6">
        <a href="/" class="hover:text-emerald-400">首页</a>
        <span>/</span>
        <a href="/airports/" class="hover:text-emerald-400">机场库</a>
        <span>/</span>
        <span class="text-[var(--text-main)]">Clash 机场</span>
      </nav>

      <div class="max-w-3xl mb-8">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-500/10 text-emerald-400 text-xs font-semibold border border-emerald-500/20 mb-3">
          <span>🐱</span>
          <span>CLASH OPTIMIZED AIRPORTS</span>
        </div>
        <h1 class="text-2xl sm:text-3xl md:text-4xl font-extrabold text-[var(--text-main)] tracking-tight mb-3">
          Clash 专属优化机场推荐
        </h1>
        <p class="text-sm text-[var(--text-muted)] leading-relaxed">
          Clash 用户最看重订阅自动更新、分流策略组清晰度与节点低延迟自动优选。本合集收录均原生提供 Clash 格式订阅转换与详尽配置教程。
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-10">
        <div class="p-4 rounded-xl bg-[var(--bg-surface)] border border-[var(--border-subtle)]">
          <h3 class="text-xs font-bold text-[var(--text-main)] mb-1">Q: Clash 怎么导入机场订阅？</h3>
          <p class="text-xs text-[var(--text-dim)]">A: 登录机场后台，点击“一键导入 Clash”或复制订阅 URL 到 Clash Verge 的“订阅”标签页粘贴导入即可。</p>
        </div>
        <div class="p-4 rounded-xl bg-[var(--bg-surface)] border border-[var(--border-subtle)]">
          <h3 class="text-xs font-bold text-[var(--text-main)] mb-1">Q: 哪个 Clash 客户端最好用？</h3>
          <p class="text-xs text-[var(--text-dim)]">A: 当前推荐使用开源活跃的 Clash Verge Rev，界面现代化且内置 Meta (Mihomo) 内核。</p>
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {clashAirports.map((airport) => (
          <AirportCard airport={airport} />
        ))}
      </div>
    </div>
  </div>
</BaseLayout>

---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import AirportCard from '../../../components/airport/AirportCard.astro';
import { getAllAirports } from '../../../utils/airports';

const unlimitedAirports = getAllAirports().filter((a) => a.unlimitedPlan);
---

<BaseLayout
  title="不限时流量机场推荐 | 按量计费长期不过期 - 机场搜"
  description="精选支持不限时按量计费 (Pay-as-you-go) 的机场服务商。一次购买长期有效，不按月清零，非常适合作为备用梯子与轻度翻墙用户。"
>
  <div class="py-12 md:py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <nav class="flex items-center gap-2 text-xs text-[var(--text-dim)] mb-6">
        <a href="/" class="hover:text-emerald-400">首页</a>
        <span>/</span>
        <a href="/airports/" class="hover:text-emerald-400">机场库</a>
        <span>/</span>
        <span class="text-[var(--text-main)]">不限时流量</span>
      </nav>

      <div class="max-w-3xl mb-8">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-500/10 text-emerald-400 text-xs font-semibold border border-emerald-500/20 mb-3">
          <span>⏳</span>
          <span>NO EXPIRATION & PAY AS YOU GO</span>
        </div>
        <h1 class="text-2xl sm:text-3xl md:text-4xl font-extrabold text-[var(--text-main)] tracking-tight mb-3">
          不限时按量计费机场推荐
        </h1>
        <p class="text-sm text-[var(--text-muted)] leading-relaxed">
          许多用户平时用量较少或仅需备用节点，常规月付套餐每月清零极易造成浪费。不限时套餐买一次可用数月甚至数年，用多少扣多少。
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-10">
        <div class="p-4 rounded-xl bg-[var(--bg-surface)] border border-[var(--border-subtle)]">
          <h3 class="text-xs font-bold text-[var(--text-main)] mb-1">Q: 不限时套餐与普通月付节点质量一样吗？</h3>
          <p class="text-xs text-[var(--text-dim)]">A: 经实测，不限时套餐通常共用相同的主力 IEPL/中转专线节点池，仅计费逻辑不同。</p>
        </div>
        <div class="p-4 rounded-xl bg-[var(--bg-surface)] border border-[var(--border-subtle)]">
          <h3 class="text-xs font-bold text-[var(--text-main)] mb-1">Q: 适合哪些使用人群？</h3>
          <p class="text-xs text-[var(--text-dim)]">A: 适合只查 Google 资料、收发海外邮件、备用应急或偶尔出差使用的小流量用户。</p>
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {unlimitedAirports.map((airport) => (
          <AirportCard airport={airport} />
        ))}
      </div>
    </div>
  </div>
</BaseLayout>

---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getAllAirports } from '../../../utils/airports';

const airports = getAllAirports();
const usAirports = airports.filter((a) => a.regions.some((r) => r.includes('美') || r.includes('US')));
---

<BaseLayout
  title="美国节点专线机场推荐 | 2026 纯净住宅 ISP 与 OpenAI/Claude 生产力专线 - 机场搜"
  description="精选 2026 优质美国原生住宅 IP 机场。覆盖美西洛杉矶、硅谷、西雅图等顶级机房，完美支持 ChatGPT 4o、Claude 3.5 Sonnet、Midjourney 与美区流媒体解锁。"
>
  <div class="py-12 md:py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <nav class="flex items-center gap-2 text-xs text-[var(--text-dim)] mb-6">
        <a href="/" class="hover:text-emerald-600 dark:hover:text-emerald-400">首页</a>
        <span>/</span>
        <a href="/airports/" class="hover:text-emerald-600 dark:hover:text-emerald-400">机场库</a>
        <span>/</span>
        <span class="text-[var(--text-main)]">美国专线专题</span>
      </nav>

      <div class="max-w-3xl mb-12">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 text-xs font-semibold border border-emerald-500/20 mb-3">
          <span>🇺🇸</span>
          <span>UNITED STATES RESIDENTIAL ISP HUB</span>
        </div>
        <h1 class="text-3xl sm:text-4xl md:text-5xl font-extrabold text-[var(--text-main)] tracking-tight">
          美国原生住宅节点精选推荐
        </h1>
        <p class="text-sm sm:text-base text-[var(--text-muted)] mt-3 leading-relaxed">
          美国是全球科技公司总部所在地。对于高频使用 <strong>OpenAI ChatGPT、Claude 3.5、Cursor、GitHub Copilot</strong> 的开发者与创作者，纯净的美国原生住宅 IP 是避免封号与 Access Denied 报错的根本保障。
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mb-12">
        {usAirports.map((ap) => (
          <div class="p-6 rounded-3xl bg-[var(--bg-surface)] border border-[var(--border-subtle)] hover:border-emerald-500/40 flex flex-col justify-between space-y-4 shadow-lg group transition-all">
            <div>
              <div class="flex items-center justify-between mb-3">
                <h3 class="text-base font-bold text-[var(--text-main)] group-hover:text-emerald-600 dark:group-hover:text-emerald-400 transition-colors">
                  {ap.name}
                </h3>
                <span class="text-sm font-mono font-bold text-emerald-600 dark:text-emerald-400">
                  ¥{ap.price.startingMonthly}/月起
                </span>
              </div>
              <p class="text-xs text-[var(--text-dim)] leading-relaxed mb-3">
                {ap.tagline}
              </p>
              <div class="text-[11px] font-mono text-emerald-600 dark:text-emerald-400">
                🤖 AI 优化：原生纯净住宅 IP | 美区全解锁
              </div>
            </div>
            <div class="pt-3 border-t border-[var(--border-subtle)] flex items-center justify-between">
              <a href={`/airport/${ap.slug}/`} class="text-xs font-semibold text-emerald-600 dark:text-emerald-400 hover:underline">
                查看 1500字评测 →
              </a>
              <a
                href={ap.affiliateUrl}
                target="_blank"
                rel="nofollow noopener"
                class="text-xs px-3 py-1 rounded-lg bg-emerald-600 hover:bg-emerald-500 text-white font-bold transition-colors"
              >
                官网直达 ↗
              </a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</BaseLayout>

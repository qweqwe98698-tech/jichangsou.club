---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getAllAnswers } from '../../data/answersData';

const answers = getAllAnswers();

const categories = ['全部', '故障排查', '流媒体解锁', 'AI 工具避坑', '安全与隐私', '协议原理', '选购指南', '进阶技巧'];

const pageSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: answers.map((a) => ({
    '@type': 'Question',
    name: a.title,
    acceptedAnswer: {
      '@type': 'Answer',
      text: a.quickAnswer,
    },
  })),
};
---

<BaseLayout
  title="问题答案中心 (Decision Q&A) | 18 大高频故障排查、协议原理与选购避坑指南 - 机场搜"
  description="收录 18 大高频机场使用问题、节点全红超时排查、Netflix/ChatGPT 报错、DNS 泄露防护与协议科普。提供 30 秒直接结论与 1500+ 字手把手解决步骤。"
  schema={pageSchema}
>
  <div class="py-12 md:py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Breadcrumb -->
      <nav class="flex items-center gap-2 text-xs text-[var(--text-dim)] mb-6">
        <a href="/" class="hover:text-emerald-600 dark:hover:text-emerald-400">首页</a>
        <span>/</span>
        <span class="text-[var(--text-main)]">问题答案中心</span>
      </nav>

      <!-- Page Header -->
      <div class="max-w-3xl mb-10">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 text-xs font-semibold border border-emerald-500/20 mb-3">
          <span>💡</span>
          <span>DECISION Q&A KNOWLEDGE BASE · 18+ TOPICS</span>
        </div>
        <h1 class="text-3xl sm:text-4xl md:text-5xl font-extrabold text-[var(--text-main)] tracking-tight mb-3">
          问题答案中心
        </h1>
        <p class="text-sm sm:text-base text-[var(--text-muted)] leading-relaxed">
          针对用户最高频的<strong>连接故障、订阅异常、流媒体风控、AI 报错与选购疑问</strong>，提供 30 秒直接结论与 1500 字深度解决方案。
        </p>
      </div>

      <!-- Category Filter Tabs -->
      <div class="flex items-center gap-2 overflow-x-auto pb-4 mb-8 text-xs scrollbar-none">
        {categories.map((cat, idx) => (
          <button
            type="button"
            class={`category-tab px-4 py-2 rounded-xl font-bold whitespace-nowrap transition-all cursor-pointer ${
              idx === 0
                ? 'bg-emerald-600 text-white shadow-md'
                : 'bg-[var(--bg-surface)] text-[var(--text-dim)] hover:text-[var(--text-main)] border border-[var(--border-subtle)]'
            }`}
            data-cat={cat}
          >
            {cat}
          </button>
        ))}
      </div>

      <!-- 18 Q&A Cards Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mb-16" id="qa-cards-grid">
        {answers.map((item) => (
          <div
            class="qa-card rounded-3xl bg-[var(--bg-surface)] border border-[var(--border-subtle)] hover:border-emerald-500/40 p-6 flex flex-col justify-between space-y-4 shadow-sm hover:shadow-lg transition-all group"
            data-category={item.category}
          >
            <div>
              <div class="flex items-center justify-between gap-2 mb-3">
                <span class="text-[10px] font-bold px-2 py-0.5 rounded bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/20">
                  {item.category}
                </span>
                <span class="text-[11px] text-[var(--text-dim)] font-mono">
                  ⏱️ {item.readingTime.split('·')[0]}
                </span>
              </div>
              <h2 class="text-base font-bold text-[var(--text-main)] group-hover:text-emerald-600 dark:group-hover:text-emerald-400 transition-colors leading-snug mb-2">
                {item.title}
              </h2>
              <p class="text-xs text-[var(--text-dim)] leading-relaxed line-clamp-3">
                {item.quickAnswer}
              </p>
            </div>
            <div class="pt-3 border-t border-[var(--border-subtle)] flex items-center justify-between">
              <a
                href={`/answers/${item.slug}/`}
                class="text-xs font-bold text-emerald-600 dark:text-emerald-400 group-hover:underline flex items-center gap-1"
              >
                <span>阅读 30 秒快答与 1500字深度方案</span>
                <span>→</span>
              </a>
            </div>
          </div>
        ))}
      </div>

      <!-- Bottom Philosophy Box -->
      <div class="p-6 sm:p-8 rounded-3xl bg-[var(--bg-surface)] border border-[var(--border-subtle)] text-center space-y-3 max-w-3xl mx-auto">
        <h3 class="text-base font-bold text-[var(--text-main)]">
          💡 最高级原则：每一个页面既解决一个问题，也准备好最合理的下一步
        </h3>
        <p class="text-xs text-[var(--text-muted)] leading-relaxed">
          没找到您遇到的特殊问题？欢迎前往 <a href="/clients/" class="text-emerald-600 dark:text-emerald-400 font-bold underline">全平台客户端中心</a> 查阅手把手客户端配置，或在 <a href="/compare/" class="text-emerald-600 dark:text-emerald-400 font-bold underline">对比中心</a> 筛选高 SLA 稳定机场。
        </p>
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  const tabs = document.querySelectorAll('.category-tab');
  const cards = document.querySelectorAll('.qa-card');

  tabs.forEach((tab) => {
    tab.addEventListener('click', () => {
      tabs.forEach((t) => {
        t.classList.remove('bg-emerald-600', 'text-white', 'shadow-md');
        t.classList.add('bg-[var(--bg-surface)]', 'text-[var(--text-dim)]', 'border', 'border-[var(--border-subtle)]');
      });
      tab.classList.add('bg-emerald-600', 'text-white', 'shadow-md');
      tab.classList.remove('bg-[var(--bg-surface)]', 'text-[var(--text-dim)]', 'border', 'border-[var(--border-subtle)]');

      const selectedCat = tab.getAttribute('data-cat');

      cards.forEach((card) => {
        const cardCat = card.getAttribute('data-category');
        if (selectedCat === '全部' || cardCat === selectedCat || (selectedCat && cardCat?.includes(selectedCat))) {
          (card as HTMLElement).style.display = 'flex';
        } else {
          (card as HTMLElement).style.display = 'none';
        }
      });
    });
  });
</script>

---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getAllClients } from '../../data/clientsData';

export async function getStaticPaths() {
  const guides = getAllClients();
  return guides.map((guide) => ({
    params: { slug: guide.slug },
    props: { guide },
  }));
}

const { guide } = Astro.props;

const pageSchema = {
  '@context': 'https://schema.org',
  '@type': 'TechArticle',
  headline: guide.title,
  description: guide.summary,
  wordCount: guide.wordCount,
  inLanguage: 'zh-CN',
  datePublished: `${guide.lastUpdated}T08:00:00+08:00`,
  dateModified: `${guide.lastUpdated}T12:00:00+08:00`,
  author: {
    '@type': 'Organization',
    name: '机场搜网络技术评测组',
    url: 'https://jichangsou.club/about/',
  },
  publisher: {
    '@type': 'Organization',
    name: '机场搜 Decision Hub',
    url: 'https://jichangsou.club',
    logo: {
      '@type': 'ImageObject',
      url: 'https://jichangsou.club/favicon.svg',
    },
  },
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': `https://jichangsou.club/clients/${guide.slug}/`,
  },
};

const howToSchema = {
  '@context': 'https://schema.org',
  '@type': 'HowTo',
  name: guide.title,
  description: guide.summary,
  inLanguage: 'zh-CN',
  step: guide.steps.map((step, idx) => ({
    '@type': 'HowToStep',
    position: idx + 1,
    name: step.title,
    text: step.desc,
    url: `https://jichangsou.club/clients/${guide.slug}/#step-${step.stepNumber}`,
  })),
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: guide.faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: {
      '@type': 'Answer',
      text: f.a,
    },
  })),
};
---

<BaseLayout
  title={`${guide.title} - 机场搜`}
  description={guide.summary}
  schema={{ ...pageSchema, ...howToSchema, ...faqSchema }}
>
  <div class="py-10 md:py-14">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Breadcrumb -->
      <nav class="flex items-center gap-2 text-xs text-[var(--text-dim)] mb-6">
        <a href="/" class="hover:text-emerald-600 dark:hover:text-emerald-400">首页</a>
        <span>/</span>
        <a href="/clients/" class="hover:text-emerald-600 dark:hover:text-emerald-400">客户端教程</a>
        <span>/</span>
        <span class="text-[var(--text-main)]">{guide.name}</span>
      </nav>

      <!-- Header & Metadata -->
      <div class="mb-8">
        <div class="flex flex-wrap items-center gap-2 mb-3">
          <span class="text-xs font-semibold px-2.5 py-0.5 rounded-full bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/20">
            {guide.platform}
          </span>
          <span class="text-xs text-[var(--text-dim)] font-mono">
            🏷️ {guide.version}
          </span>
          <span class="text-xs text-[var(--text-dim)] font-mono">
            ⏱️ {guide.readingTime}
          </span>
          <span class="text-xs text-[var(--text-dim)] font-mono">
            📅 更新于 {guide.lastUpdated}
          </span>
          <span class="text-xs text-emerald-600 dark:text-emerald-400 font-mono">
            ✍️ 机场搜技术评测组
          </span>
        </div>
        <h1 class="text-2xl sm:text-3xl md:text-4xl font-extrabold text-[var(--text-main)] tracking-tight leading-tight mb-4">
          {guide.title}
        </h1>
        <p class="text-sm text-[var(--text-muted)] leading-relaxed">
          {guide.summary}
        </p>
      </div>

      <!-- Quick Navigation ToC -->
      <div class="p-4 rounded-2xl bg-[var(--bg-surface)] border border-[var(--border-subtle)] mb-8 flex flex-wrap items-center justify-between gap-3 text-xs shadow-sm">
        <div class="flex items-center gap-2 font-bold text-[var(--text-main)]">
          <span>📑</span>
          <span>教程步骤直达：</span>
        </div>
        <div class="flex flex-wrap items-center gap-2 text-[var(--text-dim)]">
          <a href="#overview" class="hover:text-emerald-600 dark:hover:text-emerald-400">定位解析</a>
          <span>•</span>
          <a href="#steps" class="hover:text-emerald-600 dark:hover:text-emerald-400">图文步骤向导</a>
          <span>•</span>
          <a href="#advanced" class="hover:text-emerald-600 dark:hover:text-emerald-400">进阶调优</a>
          <span>•</span>
          <a href="#faqs" class="hover:text-emerald-600 dark:hover:text-emerald-400">高频 FAQ</a>
        </div>
      </div>

      <!-- 01. Overview -->
      <article id="overview" class="p-6 sm:p-8 rounded-3xl bg-[var(--bg-surface)] border border-[var(--border-subtle)] space-y-4 mb-8 shadow-sm">
        <div class="article-content" set:html={guide.overviewHtml} />
      </article>

      <!-- 02. Step-by-Step Tutorial with Visual UI Cards -->
      <div id="steps" class="space-y-8 mb-10">
        <div class="flex items-center gap-2 text-lg font-bold text-[var(--text-main)] border-b border-[var(--border-subtle)] pb-3">
          <span class="w-2 h-5 bg-emerald-500 rounded-sm"></span>
          <span>手把手图文操作全流程教学</span>
        </div>

        {guide.steps.map((step) => (
          <div id={`step-${step.stepNumber}`} class="p-6 sm:p-8 rounded-3xl bg-[var(--bg-surface)] border border-[var(--border-subtle)] space-y-5 shadow-md">
            <!-- Step Title -->
            <div class="flex items-start gap-4">
              <div class="w-10 h-10 rounded-2xl bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 font-extrabold font-mono text-base flex items-center justify-center shrink-0 border border-emerald-500/20 shadow-inner">
                {step.stepNumber}
              </div>
              <div class="space-y-1">
                <h3 class="text-base sm:text-lg font-bold text-[var(--text-main)]">{step.title}</h3>
                <p class="text-xs sm:text-sm text-[var(--text-muted)] leading-relaxed">{step.desc}</p>
              </div>
            </div>

            <!-- UI Interactive Mockup Card -->
            <div class="rounded-2xl bg-[var(--bg-card)] border border-[var(--border-strong)] p-4 sm:p-5 shadow-inner space-y-3">
              <div class="flex items-center justify-between border-b border-[var(--border-subtle)] pb-2.5">
                <div class="flex items-center gap-2">
                  <div class="flex items-center gap-1.5">
                    <span class="w-2.5 h-2.5 rounded-full bg-rose-500/80"></span>
                    <span class="w-2.5 h-2.5 rounded-full bg-amber-500/80"></span>
                    <span class="w-2.5 h-2.5 rounded-full bg-emerald-500/80"></span>
                  </div>
                  <span class="text-xs font-bold text-[var(--text-main)] font-mono ml-2">{step.uiMockup.title}</span>
                </div>
                <span class="text-[10px] font-mono font-bold px-2 py-0.5 rounded bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/20">
                  {step.uiMockup.badge}
                </span>
              </div>

              <!-- Key Value Metrics Grid -->
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5 text-xs font-mono">
                {step.uiMockup.details.map((item) => (
                  <div class={`p-2.5 rounded-xl border flex items-center justify-between ${
                    item.highlight
                      ? 'bg-emerald-500/10 border-emerald-500/30 text-emerald-700 dark:text-emerald-300 font-bold'
                      : 'bg-[var(--bg-surface)] border-[var(--border-subtle)] text-[var(--text-muted)]'
                  }`}>
                    <span class="text-[11px] text-[var(--text-dim)]">{item.label}:</span>
                    <span class="text-right text-xs">{item.value}</span>
                  </div>
                ))}
              </div>

              {step.uiMockup.hint && (
                <div class="text-[11px] text-[var(--text-dim)] pt-1">
                  {step.uiMockup.hint}
                </div>
              )}
            </div>
          </div>
        ))}
      </div>

      <!-- 03. Advanced Tips -->
      <article id="advanced" class="p-6 sm:p-8 rounded-3xl bg-[var(--bg-surface)] border border-[var(--border-subtle)] space-y-4 mb-8 shadow-sm">
        <div class="article-content" set:html={guide.advancedTipsHtml} />
      </article>

      <!-- 04. FAQs -->
      <div id="faqs" class="p-6 sm:p-8 rounded-3xl bg-[var(--bg-surface)] border border-[var(--border-subtle)] space-y-4 mb-10">
        <h2 class="text-lg font-bold text-[var(--text-main)] flex items-center gap-2">
          <span>❓</span>
          {guide.name} 常见疑问解答
        </h2>
        <div class="space-y-3">
          {guide.faqs.map((faq) => (
            <div class="p-4 rounded-2xl bg-[var(--bg-card)] border border-[var(--border-subtle)] space-y-1.5">
              <h3 class="text-xs sm:text-sm font-bold text-[var(--text-main)]">Q: {faq.q}</h3>
              <p class="text-xs text-[var(--text-muted)] leading-relaxed">A: {faq.a}</p>
            </div>
          ))}
        </div>
      </div>

      <!-- 05. User Journey Progressive Next Steps (最高级原则：准备好最合理的下一步) -->
      <div class="space-y-6 pt-4 border-t border-[var(--border-subtle)]">
        <div class="text-center max-w-xl mx-auto mb-6">
          <span class="text-xs font-semibold px-3 py-1 rounded-full bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/20">
            🎯 完整用户决策旅程 (NEXT STEPS)
          </span>
          <h2 class="text-lg sm:text-xl font-extrabold text-[var(--text-main)] mt-2">
            配置完成？下一步挑选完美适配的专线节点
          </h2>
          <p class="text-xs text-[var(--text-dim)] mt-1">
            每个页面既要解决一个问题，也要为用户准备好最合理的下一步
          </p>
        </div>

        <!-- 1. Contextual Optimized Airports -->
        <div class="p-6 rounded-3xl bg-[var(--bg-surface)] border border-[var(--border-subtle)] space-y-4">
          <h3 class="text-sm font-bold text-[var(--text-main)] flex items-center gap-2">
            <span>⚡</span>
            经实测完美适配 {guide.name} 的精选机场服务商
          </h3>
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
            {guide.optimizedAirports.map((ap) => (
              <div class="p-4 rounded-2xl bg-[var(--bg-card)] border border-[var(--border-subtle)] flex flex-col justify-between space-y-2">
                <div>
                  <div class="flex items-center justify-between mb-1">
                    <span class="text-sm font-bold text-[var(--text-main)]">{ap.name}</span>
                    <span class="text-xs font-mono font-bold text-emerald-600 dark:text-emerald-400">¥{ap.startingPrice}/月</span>
                  </div>
                  <p class="text-[11px] text-[var(--text-dim)] leading-relaxed">{ap.feature}</p>
                </div>
                <a
                  href={`/airport/${ap.slug}/`}
                  class="text-xs font-semibold text-emerald-600 dark:text-emerald-400 hover:underline pt-2 border-t border-[var(--border-subtle)]"
                >
                  查看 1500字评测与测速图 →
                </a>
              </div>
            ))}
          </div>
        </div>

        <!-- 2. Related Troubleshooting Q&As -->
        <div class="p-6 rounded-3xl bg-[var(--bg-surface)] border border-[var(--border-subtle)] space-y-3">
          <h3 class="text-sm font-bold text-[var(--text-main)] flex items-center gap-2">
            <span>🔗</span>
            使用过程中遇到问题？直达解决方案
          </h3>
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
            {guide.relatedAnswers.map((ra) => (
              <a
                href={`/answers/${ra.slug}/`}
                class="p-3 rounded-xl bg-[var(--bg-card)] border border-[var(--border-subtle)] hover:border-emerald-500/40 text-xs font-medium text-[var(--text-main)] hover:text-emerald-600 dark:hover:text-emerald-400 block transition-colors"
              >
                {ra.title}
              </a>
            ))}
          </div>
        </div>

        <!-- 3. Bottom Philosophy Footer Pill -->
        <div class="p-4 rounded-2xl bg-[var(--bg-surface)] border border-[var(--border-subtle)] text-center text-[11px] text-[var(--text-dim)] font-medium">
          💡 <strong>机场搜 Decision Hub 承诺：</strong>先帮您把客户端配置与分流配置调顺畅，再为您提供客观透明的多维选型参考。
        </div>
      </div>
    </div>
  </div>
</BaseLayout>

<style is:global>
  .article-content h2 {
    font-size: 1.15rem;
    font-weight: 800;
    color: var(--text-main);
    margin-top: 1.2rem;
    margin-bottom: 0.75rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--border-subtle);
  }
  .article-content p {
    margin-bottom: 0.85rem;
    line-height: 1.75;
  }
  .article-content ul, .article-content ol {
    margin-bottom: 1rem;
    padding-left: 1.25rem;
    space-y: 0.4rem;
  }
  .article-content ul {
    list-style-type: disc;
  }
  .article-content ol {
    list-style-type: decimal;
  }
  .article-content li {
    margin-bottom: 0.35rem;
    line-height: 1.6;
  }
  .article-content strong {
    color: var(--text-main);
    font-weight: 700;
  }
  .article-content code {
    font-family: monospace;
    font-size: 0.85em;
    background: var(--bg-card);
    padding: 0.15rem 0.4rem;
    border-radius: 0.375rem;
    border: 1px solid var(--border-subtle);
    color: #059669;
  }
  html.dark .article-content code {
    color: #34d399;
  }
</style>

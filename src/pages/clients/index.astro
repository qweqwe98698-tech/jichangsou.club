---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getAllClients } from '../../data/clientsData';

const clients = getAllClients();

const pageSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: '客户端教程与配置中心 - 机场搜',
  description: '全平台代理客户端下载、配置与订阅导入图文教程。涵盖 iOS、Android、Windows、macOS 全生态 10 大主流客户端。',
  url: 'https://jichangsou.club/clients/',
};
---

<BaseLayout
  title="客户端教程与配置中心 | 覆盖 iOS / Android / Windows / Mac 全平台 10 大客户端 - 机场搜"
  description="全平台科学上网代理客户端下载、配置与订阅导入图文教程。手把手涵盖 Clash Verge Rev、Shadowrocket (小火箭)、Surge、Quantumult X (圈X)、Stash、v2rayN、v2rayNG、Clash Meta for Android、sing-box 与 Loon。"
  schema={pageSchema}
>
  <div class="py-12 md:py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <nav class="flex items-center gap-2 text-xs text-[var(--text-dim)] mb-6">
        <a href="/" class="hover:text-emerald-600 dark:hover:text-emerald-400">首页</a>
        <span>/</span>
        <span class="text-[var(--text-main)]">客户端教程中心</span>
      </nav>

      <div class="max-w-3xl mb-12">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 text-xs font-semibold border border-emerald-500/20 mb-3">
          <span>📱</span>
          <span>CROSS-PLATFORM CLIENT ECOSYSTEM</span>
        </div>
        <h1 class="text-3xl sm:text-4xl md:text-5xl font-extrabold text-[var(--text-main)] tracking-tight">
          全平台客户端教程与配置中心
        </h1>
        <p class="text-sm sm:text-base text-[var(--text-muted)] mt-3 leading-relaxed">
          全面覆盖 <strong>iOS (iPhone/iPad)、Android 安卓、Windows PC、macOS 苹果电脑与 Apple TV</strong> 全生态 10 大主流代理客户端。步骤详尽，配有高保真界面图解，新手 3 分钟即可配置就绪。
        </p>
      </div>

      <!-- Quick Platform Filter Badges -->
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 mb-10 text-center text-xs">
        <div class="p-3.5 rounded-2xl bg-[var(--bg-surface)] border border-[var(--border-subtle)]">
          <div class="font-bold text-[var(--text-main)]">🍏 苹果 iOS / Mac</div>
          <div class="text-[11px] text-[var(--text-dim)] mt-0.5">小火箭 · Surge · 圈X · Stash · Loon</div>
        </div>
        <div class="p-3.5 rounded-2xl bg-[var(--bg-surface)] border border-[var(--border-subtle)]">
          <div class="font-bold text-[var(--text-main)]">🤖 安卓 Android</div>
          <div class="text-[11px] text-[var(--text-dim)] mt-0.5">v2rayNG · CMFA · sing-box</div>
        </div>
        <div class="p-3.5 rounded-2xl bg-[var(--bg-surface)] border border-[var(--border-subtle)]">
          <div class="font-bold text-[var(--text-main)]">💻 电脑 Windows / Mac</div>
          <div class="text-[11px] text-[var(--text-dim)] mt-0.5">Clash Verge · v2rayN · Surge</div>
        </div>
        <div class="p-3.5 rounded-2xl bg-[var(--bg-surface)] border border-[var(--border-subtle)]">
          <div class="font-bold text-[var(--text-main)]">⚡ 下一代全平台</div>
          <div class="text-[11px] text-[var(--text-dim)] mt-0.5">sing-box 通用内核</div>
        </div>
      </div>

      <!-- Clients 10-Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-16">
        {clients.map((c) => (
          <a
            href={`/clients/${c.slug}/`}
            class="p-6 rounded-3xl bg-[var(--bg-surface)] border border-[var(--border-subtle)] hover:border-emerald-500/40 hover:bg-[var(--bg-surface-elevated)] transition-all group flex items-start gap-4 shadow-sm"
          >
            <div class="w-14 h-14 rounded-2xl bg-[var(--bg-card)] border border-[var(--border-subtle)] flex items-center justify-center text-3xl shrink-0 group-hover:scale-105 transition-transform shadow-inner">
              {c.icon}
            </div>
            <div class="flex-1">
              <div class="flex items-center justify-between gap-2">
                <h2 class="text-base sm:text-lg font-bold text-[var(--text-main)] group-hover:text-emerald-600 dark:group-hover:text-emerald-400 transition-colors">
                  {c.name}
                </h2>
                <span class="text-[10px] font-mono px-2 py-0.5 rounded bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/20">
                  {c.version.split(' ')[0]}
                </span>
              </div>
              <span class="text-xs text-emerald-600 dark:text-emerald-400 font-mono block mt-0.5">{c.platform}</span>
              <p class="text-xs text-[var(--text-dim)] mt-2 leading-relaxed line-clamp-2">{c.summary}</p>
              <div class="mt-3 text-xs font-semibold text-emerald-600 dark:text-emerald-400 flex items-center gap-1">
                <span>阅读完整配置指南</span>
                <span>→</span>
              </div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </div>
</BaseLayout>

---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getAllAirports, getAirportBySlug } from '../../utils/airports';

const all = getAllAirports();

const comparePairs = [
  { slug1: 'guangsu', slug2: 'yuzhou', title: '光速云 VS 宇宙云', highlight: '老牌 IEPL 专线 vs 高性价比 15元专线' },
  { slug1: 'xingdaomeng', slug2: 'lingmao', title: '星岛盟 VS 灵猫云', highlight: '流媒体大带宽专线 vs 稳定综合型专线' },
  { slug1: 'feimao', slug2: 'weitu', title: '飞猫云 VS 唯兔云', highlight: '三网优化专线 vs 多节点极速网络' },
  { slug1: 'u1s1', slug2: 'jilian', title: 'U1S1 VS 极连云', highlight: '20元档 VLESS 协议专线深度横评' },
  { slug1: 'guangnianti', slug2: 'sogo', title: '光年梯 VS SOGO云', highlight: '高综合评分品牌稳定性横评' },
  { slug1: 'kexin', slug2: 'sujie', title: '可信云 VS 速界', highlight: '多入口中转容灾 vs 极速入门选型' },
  { slug1: 'kuaili', slug2: 'quanqiu', title: '快狸云 VS 全球互联', highlight: '大流量套餐与全球节点覆盖对比' },
  { slug1: 'yifan', slug2: 'ermao', title: '一翻云 VS 二猫云', highlight: '高性价比月付专线方案实测对比' },
];
---

<BaseLayout
  title="机场多维参数对比系统 | 选机场不踩坑 - 机场搜"
  description="支持 2~4 家机场横向对比。从价格、线路架构、解锁能力、协议与客户端支持全面剖析。"
>
  <div class="py-12 md:py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <nav class="flex items-center gap-2 text-xs text-[var(--text-dim)] mb-6">
        <a href="/" class="hover:text-emerald-400">首页</a>
        <span>/</span>
        <span class="text-[var(--text-main)]">机场对比</span>
      </nav>

      <div class="max-w-3xl mb-8">
        <h1 class="text-2xl sm:text-3xl md:text-4xl font-extrabold text-[var(--text-main)] tracking-tight mb-3">
          机场多维参数对比
        </h1>
        <p class="text-sm text-[var(--text-muted)] leading-relaxed">
          将关键技术参数、价格与真实服务状态横向展开，差异一目了然。
        </p>
      </div>

      <!-- Compare Table Matrix -->
      <div class="rounded-2xl bg-[var(--bg-surface)] border border-[var(--border-strong)] shadow-xl overflow-hidden mb-14">
        <div class="overflow-x-auto">
          <table class="w-full text-xs sm:text-sm text-left border-collapse">
            <thead>
              <tr class="bg-[var(--bg-card)] border-b border-[var(--border-subtle)]">
                <th class="p-4 sm:p-5 font-bold text-[var(--text-main)] min-w-[140px]">对比项目</th>
                {all.slice(0, 4).map((a) => (
                  <th class="p-4 sm:p-5 font-bold text-[var(--text-main)] min-w-[180px] text-center border-l border-[var(--border-subtle)]">
                    <div class="flex flex-col items-center gap-1.5">
                      <span class="text-base sm:text-lg">{a.name}</span>
                      <span class="text-xs font-normal text-[var(--text-dim)]">{a.tagline}</span>
                    </div>
                  </th>
                ))}
              </tr>
            </thead>
            <tbody class="divide-y divide-[var(--border-subtle)] text-[var(--text-muted)]">
              <tr>
                <td class="p-4 font-semibold text-[var(--text-dim)]">起步月费</td>
                {all.slice(0, 4).map((a) => (
                  <td class="p-4 text-center font-mono font-bold text-emerald-400 text-base border-l border-[var(--border-subtle)]">
                    ¥{a.price.startingMonthly}/月
                  </td>
                ))}
              </tr>
              <tr>
                <td class="p-4 font-semibold text-[var(--text-dim)]">线路架构</td>
                {all.slice(0, 4).map((a) => (
                  <td class="p-4 text-center border-l border-[var(--border-subtle)] font-medium text-[var(--text-main)]">
                    {a.routes.join(' + ')}
                  </td>
                ))}
              </tr>
              <tr>
                <td class="p-4 font-semibold text-[var(--text-dim)]">支持协议</td>
                {all.slice(0, 4).map((a) => (
                  <td class="p-4 text-center border-l border-[var(--border-subtle)] font-mono text-xs">
                    {a.protocols.join(', ')}
                  </td>
                ))}
              </tr>
              <tr>
                <td class="p-4 font-semibold text-[var(--text-dim)]">ChatGPT / Claude</td>
                {all.slice(0, 4).map((a) => (
                  <td class="p-4 text-center border-l border-[var(--border-subtle)]">
                    {a.ai.chatgpt && a.ai.claude ? (
                      <span class="text-emerald-400 font-semibold">✅ 全支持</span>
                    ) : (
                      <span class="text-amber-400 font-semibold">⚡ 支持 ChatGPT</span>
                    )}
                  </td>
                ))}
              </tr>
              <tr>
                <td class="p-4 font-semibold text-[var(--text-dim)]">流媒体 4K 解锁</td>
                {all.slice(0, 4).map((a) => (
                  <td class="p-4 text-center border-l border-[var(--border-subtle)]">
                    {a.streaming.netflix ? (
                      <span class="text-emerald-400 font-semibold">✅ 支持 Netflix/YT</span>
                    ) : (
                      <span class="text-[var(--text-dim)]">待核验</span>
                    )}
                  </td>
                ))}
              </tr>
              <tr>
                <td class="p-4 font-semibold text-[var(--text-dim)]">体验政策</td>
                {all.slice(0, 4).map((a) => (
                  <td class="p-4 text-center border-l border-[var(--border-subtle)] text-xs">
                    {a.trial.supported ? a.trial.details : '无免费试用'}
                  </td>
                ))}
              </tr>
              <tr>
                <td class="p-4 font-semibold text-[var(--text-dim)]">核验日期</td>
                {all.slice(0, 4).map((a) => (
                  <td class="p-4 text-center border-l border-[var(--border-subtle)] font-mono text-xs text-[var(--text-dim)]">
                    {a.lastVerified}
                  </td>
                ))}
              </tr>
              <tr class="bg-[var(--bg-card)]/50">
                <td class="p-4 font-semibold text-[var(--text-dim)]">操作</td>
                {all.slice(0, 4).map((a) => (
                  <td class="p-4 text-center border-l border-[var(--border-subtle)]">
                    <a
                      href={a.affiliateUrl}
                      target="_blank"
                      rel="nofollow sponsored noopener noreferrer"
                      class="inline-block px-4 py-1.5 rounded-lg bg-emerald-600 hover:bg-emerald-500 text-white font-semibold text-xs transition-colors"
                    >
                      直达官网
                    </a>
                  </td>
                ))}
              </tr>
            </tbody>
          </table>
        </div>
      </div>

      <!-- 1v1 Deep Head-to-Head Comparison Showcases -->
      <section class="space-y-6">
        <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-3 border-b border-[var(--border-subtle)] pb-4">
          <div>
            <div class="inline-flex items-center gap-1.5 text-xs font-semibold text-emerald-600 dark:text-emerald-400 mb-1">
              <span>⚖️</span>
              <span>1v1 经典对决专题</span>
            </div>
            <h2 class="text-xl sm:text-2xl font-extrabold text-[var(--text-main)]">
              热门机场 1v1 深度横向对比专栏
            </h2>
          </div>
          <p class="text-xs text-[var(--text-dim)]">
            基于真实测速与参数交叉比对，深度剖析不同品牌在晚高峰、价格与协议上的差异
          </p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
          {comparePairs.map((pair) => {
            const ap1 = getAirportBySlug(pair.slug1);
            const ap2 = getAirportBySlug(pair.slug2);
            return (
              <a
                href={`/compare/${pair.slug1}-vs-${pair.slug2}/`}
                class="group p-5 rounded-2xl bg-[var(--bg-surface)] border border-[var(--border-subtle)] hover:border-emerald-500/50 hover:shadow-lg transition-all flex flex-col justify-between"
              >
                <div>
                  <div class="flex items-center justify-between gap-2 mb-4">
                    <div class="flex items-center gap-2">
                      <div class="w-9 h-9 rounded-xl bg-[var(--bg-card)] border border-[var(--border-subtle)] p-1.5 flex items-center justify-center shrink-0">
                        {ap1?.logo && <img src={ap1.logo} alt={ap1.name} class="w-full h-full object-contain" />}
                      </div>
                      <span class="text-xs font-bold text-[var(--text-main)]">{ap1?.name}</span>
                    </div>
                    <span class="text-xs font-extrabold text-amber-500 font-mono">VS</span>
                    <div class="flex items-center gap-2">
                      <span class="text-xs font-bold text-[var(--text-main)]">{ap2?.name}</span>
                      <div class="w-9 h-9 rounded-xl bg-[var(--bg-card)] border border-[var(--border-subtle)] p-1.5 flex items-center justify-center shrink-0">
                        {ap2?.logo && <img src={ap2.logo} alt={ap2.name} class="w-full h-full object-contain" />}
                      </div>
                    </div>
                  </div>

                  <h3 class="text-sm font-bold text-[var(--text-main)] group-hover:text-emerald-600 dark:group-hover:text-emerald-400 transition-colors mb-1.5">
                    {pair.title}
                  </h3>
                  <p class="text-xs text-[var(--text-dim)] leading-relaxed">
                    {pair.highlight}
                  </p>
                </div>

                <div class="pt-4 mt-4 border-t border-[var(--border-subtle)] flex items-center justify-between text-xs">
                  <span class="text-emerald-600 dark:text-emerald-400 font-medium group-hover:underline">
                    查看详细评测对比 →
                  </span>
                  <span class="font-mono text-[11px] text-[var(--text-dim)]">
                    ¥{ap1?.price.startingMonthly} vs ¥{ap2?.price.startingMonthly}
                  </span>
                </div>
              </a>
            );
          })}
        </div>
      </section>
    </div>
  </div>
</BaseLayout>

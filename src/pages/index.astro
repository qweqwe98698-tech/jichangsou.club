---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroSection from '../components/home/HeroSection.astro';
import FeaturedAirports from '../components/home/FeaturedAirports.astro';
import DecisionWizard from '../components/home/DecisionWizard';
import HomeComparePreview from '../components/home/HomeComparePreview.astro';
import HomeTutorials from '../components/home/HomeTutorials.astro';
import HomeAnswerCenter from '../components/home/HomeAnswerCenter.astro';
import TrustBar from '../components/home/TrustBar.astro';
import { getAllAirports } from '../utils/airports';

const airports = getAllAirports();

const pageSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: '机场搜 jichangsou.club',
  headline: '机场搜 · 搜得准 · 比得清 · 选得好 | 机场与VPN决策枢纽',
  description: '专业的机场与网络决策平台，提供真实数据核验、多维机场对比、新手客户端教程与常见问题解答。',
  url: 'https://jichangsou.club/',
};
---

<BaseLayout
  title="机场搜 - 2026稳定机场推荐与评测导航 | 便宜专线/Clash小火箭节点订阅对比"
  description="机场搜 (jichangsou.club) 专业的机场推荐、评测导航与节点对比平台。收录16+实测专线机场，提供2026稳定便宜梯子推荐、Clash/小火箭订阅配置、真实节点测速与智能选机场向导。"
  schema={pageSchema}
>
  <!-- 01 Hero Section with 4-Mode Search & Integrity Metrics -->
  <HeroSection />

  <!-- 02 Curated Selection & Decision Wizard Row -->
  <div class="border-b border-[var(--border-subtle)] bg-[var(--bg-main)]">
    <!-- Featured Selection -->
    <FeaturedAirports />

    <!-- Decision Wizard Highlight -->
    <section class="py-12 md:py-16 bg-[var(--bg-surface)]/40 border-t border-[var(--border-subtle)]">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
          <div class="lg:col-span-5 space-y-4">
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-500/10 text-emerald-400 text-xs font-semibold border border-emerald-500/20">
              <span>🎯</span>
              <span>智能决策引擎</span>
            </div>
            <h2 class="text-2xl sm:text-3xl font-extrabold text-[var(--text-main)] tracking-tight leading-tight">
              不知道怎么选？<br />
              <span class="text-emerald-400">4 步向导帮您快速定位</span>
            </h2>
            <p class="text-xs sm:text-sm text-[var(--text-muted)] leading-relaxed">
              只需选择你的主要用途（ChatGPT/流媒体/办公/日常）、预算范围与主力设备，算法将实时从已核验数据库中筛选出最契合的候选方案，并附带客观匹配理由。
            </p>
            <div class="pt-2 flex flex-wrap gap-4 text-xs text-[var(--text-dim)]">
              <span class="flex items-center gap-1.5">
                <span class="text-emerald-400">✓</span> 拒绝无脑推荐
              </span>
              <span class="flex items-center gap-1.5">
                <span class="text-emerald-400">✓</span> 匹配真实预算
              </span>
              <span class="flex items-center gap-1.5">
                <span class="text-emerald-400">✓</span> 设备适配检查
              </span>
            </div>
          </div>

          <div class="lg:col-span-7">
            <DecisionWizard client:visible airports={airports} />
          </div>
        </div>
      </div>
    </section>
  </div>

  <!-- 03 Quick Compare Matrix & Beginner Client Tutorials -->
  <section class="py-12 md:py-16 border-b border-[var(--border-subtle)] bg-[var(--bg-main)]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
        <!-- Airport Compare Preview -->
        <HomeComparePreview />

        <!-- Beginner Client Tutorials -->
        <HomeTutorials />
      </div>
    </div>
  </section>

  <!-- 04 Question & Answer Hub + Hot Trends -->
  <HomeAnswerCenter />

  <!-- 05 Trust Pillars & Brand Slogan Bar -->
  <TrustBar />
</BaseLayout>

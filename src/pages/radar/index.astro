---
import BaseLayout from '../../layouts/BaseLayout.astro';
import RadarMonitor from '../../components/radar/RadarMonitor';
import { getAllAirports } from '../../utils/airports';

const airports = getAllAirports();
---

<BaseLayout
  title="机场雷达 | 官网可访问性、延迟与SSL证书状态监控中心 - 机场搜"
  description="实时监测主流机场官网域名、BGP 响应延迟、HTTPS 证书与 24H 连通心跳 (Uptime)。自动化小时级巡检，拒绝信息黑盒。"
>
  <div class="py-12 md:py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <nav class="flex items-center gap-2 text-xs text-[var(--text-dim)] mb-6">
        <a href="/" class="hover:text-emerald-600 dark:hover:text-emerald-400">首页</a>
        <span>/</span>
        <span class="text-[var(--text-main)]">机场雷达</span>
      </nav>

      <!-- Page Header & Radar Scanner Visual -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center mb-10">
        <div class="lg:col-span-8 space-y-3">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 text-xs font-semibold border border-emerald-500/20">
            <span class="w-2 h-2 rounded-full bg-emerald-500 beacon-pulse"></span>
            <span>NOC INFRASTRUCTURE OBSERVATORY</span>
          </div>
          <h1 class="text-2xl sm:text-3xl md:text-4xl font-extrabold text-[var(--text-main)] tracking-tight">
            机场雷达与可观测性监控中心
          </h1>
          <p class="text-sm text-[var(--text-muted)] leading-relaxed max-w-2xl">
            对收录的 16 家机场进行多线自动化可用性轮询，实时监测官网 DNS 解析、BGP 探测响应、TLS 证书有效期及 24 小时健康心跳（Uptime）。
          </p>
        </div>

        <!-- Cyber Tech Mascot & Radar Status Indicator -->
        <div class="lg:col-span-4 flex justify-center lg:justify-end">
          <div class="relative w-40 h-40 rounded-3xl border-2 border-emerald-500/30 bg-[var(--bg-surface)] p-2 shadow-2xl overflow-hidden group">
            <img
              src="/images/radar-mascot.jpg"
              alt="机场搜雷达巡检员"
              class="w-full h-full object-cover rounded-2xl group-hover:scale-105 transition-transform duration-300"
            />
            <div class="absolute bottom-2 left-2 right-2 px-2 py-1 rounded-lg bg-emerald-950/80 backdrop-blur-md border border-emerald-500/30 text-center">
              <span class="text-[10px] font-bold font-mono text-emerald-300 flex items-center justify-center gap-1">
                <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 beacon-pulse"></span>
                RADAR ACTIVE
              </span>
            </div>
          </div>
        </div>
      </div>

      <!-- Interactive Radar Dashboard Island -->
      <RadarMonitor client:load airports={airports} />
    </div>
  </div>
</BaseLayout>

---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AirportCard from '../../components/airport/AirportCard.astro';
import { getAllAirports } from '../../utils/airports';

const airports = getAllAirports();
---

<BaseLayout
  title="精选机场推荐 | 2026 稳定高性价比推荐 - 机场搜"
  description="经过多维度真实评测核验的精选机场推荐。覆盖 IEPL 专线、ChatGPT 原生解锁、流媒体 4K 追剧与平价高性价比选择。"
>
  <div class="py-12 md:py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <nav class="flex items-center gap-2 text-xs text-[var(--text-dim)] mb-6">
        <a href="/" class="hover:text-emerald-400">首页</a>
        <span>/</span>
        <span class="text-[var(--text-main)]">精选推荐</span>
      </nav>

      <div class="max-w-3xl mb-10">
        <h1 class="text-2xl sm:text-3xl md:text-4xl font-extrabold text-[var(--text-main)] tracking-tight mb-3">
          精选机场推荐
        </h1>
        <p class="text-sm text-[var(--text-muted)] leading-relaxed">
          不以“第一名”或虚假在线率排序，所有推荐均明确标明适用场景、技术路线与潜在短板，助您理性决策。
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {airports.map((airport) => (
          <AirportCard airport={airport} featured={true} />
        ))}
      </div>
    </div>
  </div>
</BaseLayout>

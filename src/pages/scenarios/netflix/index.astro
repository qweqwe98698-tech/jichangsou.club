---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import AirportCard from '../../../components/airport/AirportCard.astro';
import { getAllAirports } from '../../../utils/airports';

const netflixAirports = getAllAirports().filter((a) => a.streaming.netflix);
---

<BaseLayout
  title="Netflix / Disney+ 流媒体解锁与 4K 高码率追剧指南 - 机场搜"
  description="全区 Netflix 原生解锁、Disney+、HBO Max 与 YouTube 4K/8K 码率优化与避坑指南。"
>
  <div class="py-12 md:py-16">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <nav class="flex items-center gap-2 text-xs text-[var(--text-dim)] mb-6">
        <a href="/" class="hover:text-emerald-400">首页</a>
        <span>/</span>
        <span class="text-[var(--text-main)]">流媒体专题</span>
      </nav>

      <div class="max-w-3xl mb-8">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-red-500/10 text-red-400 text-xs font-semibold border border-red-500/20 mb-3">
          <span>🎬</span>
          <span>4K STREAMING & REGION UNLOCK</span>
        </div>
        <h1 class="text-2xl sm:text-3xl md:text-4xl font-extrabold text-[var(--text-main)] tracking-tight mb-3">
          Netflix & Disney+ 流媒体解锁指南
        </h1>
        <p class="text-sm text-[var(--text-muted)] leading-relaxed">
          普通 IP 往往只能观看 Netflix 自制剧（Originals）。支持原生家宽解锁的机场能让您完整观看非自制版权剧目并享受 4K HDR 杜比视界。
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {netflixAirports.slice(0, 6).map((airport) => (
          <AirportCard airport={airport} />
        ))}
      </div>
    </div>
  </div>
</BaseLayout>
